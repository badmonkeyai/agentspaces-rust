<!-- Jackson's chunked text strings as test vectors for agentspaces-rust (see README.md). It builds
     against the AgentSpaces 0.6.0 artifacts in the local Maven repository and changes nothing in
     the Java repository. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ai.badmonkey.agentspaces.interop</groupId>
  <artifactId>rust-jackson-vectors</artifactId>
  <version>0.5.0</version>
  <packaging>jar</packaging>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <agentspaces.version>0.6.0</agentspaces.version>
    <jackson.version>2.21.7</jackson.version>
  </properties>
  <dependencies>
    <!-- CborCodec.defaultCodec(): the encoder every Java peer writes the wire with. -->
    <dependency><groupId>ai.badmonkey.agentspaces</groupId><artifactId>agentspaces-common</artifactId><version>${agentspaces.version}</version></dependency>
    <!-- A plain CBORMapper, to record whether the codec's modules change how text is written. -->
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-cbor</artifactId><version>${jackson.version}</version></dependency>
  </dependencies>
</project>
