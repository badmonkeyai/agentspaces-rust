<!-- A scripted Java seed for agentspaces-rust interop tests. It builds against the AgentSpaces
     0.5.0 artifacts in the local Maven repository and changes nothing in the Java repository. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ai.badmonkey.agentspaces.interop</groupId>
  <artifactId>rust-interop-seed</artifactId>
  <version>0.5.0</version>
  <packaging>jar</packaging>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <agentspaces.version>0.5.0</agentspaces.version>
  </properties>
  <dependencies>
    <dependency><groupId>ai.badmonkey.agentspaces</groupId><artifactId>agentspaces-peering</artifactId><version>${agentspaces.version}</version></dependency>
    <dependency><groupId>ai.badmonkey.agentspaces</groupId><artifactId>agentspaces-space</artifactId><version>${agentspaces.version}</version></dependency>
    <dependency><groupId>ai.badmonkey.agentspaces</groupId><artifactId>agentspaces-identity</artifactId><version>${agentspaces.version}</version></dependency>
    <dependency><groupId>ai.badmonkey.agentspaces</groupId><artifactId>agentspaces-discovery</artifactId><version>${agentspaces.version}</version></dependency>
    <dependency><groupId>ai.badmonkey.agentspaces</groupId><artifactId>agentspaces-capabilities</artifactId><version>${agentspaces.version}</version></dependency>
    <dependency><groupId>ai.badmonkey.agentspaces</groupId><artifactId>agentspaces-agent</artifactId><version>${agentspaces.version}</version></dependency>
  </dependencies>
</project>
