<!-- Example 32's Java side: example 02's research fleet (ResearchFleet), as installed in the local
     Maven repository. Nothing is compiled here; the fleet test resolves this project's classpath
     offline (mvn -q -o dependency:build-classpath) and runs ResearchFleet's coordinator from it. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ai.badmonkey.agentspaces.rust</groupId>
  <artifactId>example-32-rust-fleet-java</artifactId>
  <version>0.5.0</version>
  <packaging>pom</packaging>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <agentspaces.version>0.5.0</agentspaces.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>example-02-research-fleet</artifactId>
      <version>${agentspaces.version}</version>
    </dependency>
  </dependencies>
</project>
